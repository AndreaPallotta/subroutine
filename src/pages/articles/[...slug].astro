---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { calculateReadingTime } from '../../utils/readingTime';
import { ShareArticleButton } from '../../components/ui/ShareArticleButton';
import { Clock } from 'lucide-react';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await article.render();

const readingTime = calculateReadingTime(article.body || '');

const badgeClass = 
  article.data.level === 'Beginner' ? 'badge-beginner' :
  article.data.level === 'Intermediate' ? 'badge-intermediate' : 'badge-advanced';
---

<Layout 
  title={`${article.data.title} // Subroutine CS`} 
  description={article.data.summary}
  currentSlug={article.slug}
>
  <article class="max-w-4xl mx-auto py-2 md:py-6">
    {/* Article Header Metadata */}
    <header class="mb-10 pb-8 border-b border-slate-800">
      <div class="flex flex-wrap items-center justify-between gap-4 mb-4">
        <div class="flex flex-wrap items-center gap-3">
          <a href="/" class="text-xs font-semibold text-slate-400 hover:text-cyan-400 font-mono transition-colors">← Back to Articles</a>
          <span class="text-slate-700">•</span>
          <span class="text-xs font-mono text-cyan-400 uppercase tracking-wider">{article.data.category}</span>
          <span class={`badge ${badgeClass}`}>{article.data.level}</span>
          <span class="flex items-center gap-1 text-[11px] font-mono text-slate-400 bg-slate-900/80 px-2.5 py-1 rounded-md border border-slate-800">
            <Clock className="w-3 h-3 text-cyan-400" />
            {readingTime}
          </span>
        </div>

        {/* Copy Link & Share Buttons */}
        <ShareArticleButton client:idle title={article.data.title} />
      </div>

      <h1 class="text-3xl md:text-5xl font-extrabold text-white tracking-tight mb-4 leading-tight">
        {article.data.title}
      </h1>

      <p class="text-base md:text-xl text-slate-300 leading-relaxed mb-6 font-light">
        {article.data.summary}
      </p>

      <div class="flex flex-wrap items-center justify-between gap-4 text-xs font-mono text-slate-400 pt-3 border-t border-slate-800/60">
        <div class="flex items-center gap-3">
          <span>Published: {article.data.date.toISOString().split('T')[0]}</span>
          <span>•</span>
          <div class="flex flex-wrap gap-2">
            {article.data.tags.map(tag => (
              <span class="text-indigo-400 bg-indigo-950/60 px-2 py-0.5 rounded border border-indigo-500/20">#{tag}</span>
            ))}
          </div>
        </div>
      </div>
    </header>

    {/* Rendered MDX Content with Custom CSS Article Hierarchy */}
    <div class="article-content">
      <Content />
    </div>
  </article>
</Layout>
