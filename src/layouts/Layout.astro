---
import '../styles/global.css';
import { getCollection } from 'astro:content';
import { SidebarNavigation, type ArticleNavItem } from '../components/navigation/SidebarNavigation';

interface Props {
  title?: string;
  description?: string;
  currentSlug?: string;
}

const {
  title = 'Subroutine // Interactive CS & Programming Playground',
  description = 'An interactive educational platform for algorithms, low-level systems, C++ optimization, and AI with audio-visual simulations.',
  currentSlug = '',
} = Astro.props;

const rawArticles = await getCollection('articles');
const articles: ArticleNavItem[] = rawArticles.map(art => ({
  slug: art.slug,
  title: art.data.title,
  category: art.data.category,
  level: art.data.level,
}));

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!DOCTYPE html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="google-site-verification" content="sazdq0wR9lArF-dhJ3HU9AzwxT7qdY0YtMBKLlFpSrU" />

    <!-- SEO Canonical & Sitemap Links -->
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph & Social Cards -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/favicon.svg" />

    <!-- KaTeX CSS for math typesetting -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css" />
  </head>
  <body class="min-h-screen bg-slate-950 text-slate-100 font-sans antialiased selection:bg-cyan-500 selection:text-slate-950">
    {/* Left Vertical Sidebar Navigation */}
    <SidebarNavigation client:load articles={articles} currentSlug={currentSlug} />

    {/* Main Content Area */}
    <div class="md:pl-72 min-h-screen flex flex-col">
      <main class="flex-1 max-w-5xl w-full mx-auto px-4 md:px-8 py-6 md:py-10">
        <slot />
      </main>
    </div>

    <!-- Client-Side Mermaid Diagram Renderer -->
    <script>
      import mermaid from 'mermaid';

      mermaid.initialize({
        startOnLoad: false,
        theme: 'dark',
        themeVariables: {
          darkMode: true,
          background: '#090d16',
          primaryColor: '#1e293b',
          primaryTextColor: '#f8fafc',
          primaryBorderColor: '#334155',
          lineColor: '#38bdf8',
          secondaryColor: '#0f172a',
          tertiaryColor: '#1e1b4b',
        },
      });

      async function renderMermaidDiagrams() {
        const mermaidBlocks = document.querySelectorAll('pre code.language-mermaid, pre.language-mermaid code, pre.mermaid');

        for (let i = 0; i < mermaidBlocks.length; i++) {
          const codeEl = mermaidBlocks[i];
          const preEl = codeEl.tagName.toLowerCase() === 'pre' ? codeEl : codeEl.parentElement;
          const graphDefinition = codeEl.textContent || '';

          if (!graphDefinition.trim()) continue;

          const container = document.createElement('div');
          container.className = 'mermaid-diagram my-6 p-4 rounded-2xl bg-[#090d16] border border-slate-800 flex justify-center overflow-x-auto shadow-xl';

          try {
            const { svg } = await mermaid.render(`mermaid-svg-${i}-${Date.now()}`, graphDefinition.trim());
            container.innerHTML = svg;
            if (preEl && preEl.parentNode) {
              preEl.parentNode.replaceChild(container, preEl);
            }
          } catch (err) {
            console.error('Mermaid render error:', err);
          }
        }
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', renderMermaidDiagrams);
      } else {
        renderMermaidDiagrams();
      }
    </script>
  </body>
</html>
