---
import '../styles/global.css';
import { getCollection } from 'astro:content';
import { SidebarNavigation, type ArticleNavItem } from '../components/navigation/SidebarNavigation';
import Footer from '../components/navigation/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  currentSlug?: string;
  gaMeasurementId?: string;
}

const envGaId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;

const {
  title = 'Subroutine CS - Interactive Computer Science & Systems Blog',
  description = 'Subroutine CS (subroutine-cs.cc) is an interactive educational blog covering algorithms, low-level systems optimization, C++, networking, and computer architecture with audio-visual simulations.',
  currentSlug = '',
  gaMeasurementId = envGaId || 'G-M9CEN2K5SH', // Production Google Analytics 4 Measurement ID
} = Astro.props;

const rawArticles = await getCollection('articles');
const articles: ArticleNavItem[] = rawArticles.map(art => ({
  slug: art.slug,
  title: art.data.title,
  category: art.data.category,
  level: art.data.level,
}));

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const jsonLdSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Subroutine CS",
  "alternateName": ["subroutine-cs", "subroutine-cs.cc", "Subroutine", "Subroutine CS Blog", "Subroutine Computer Science"],
  "url": "https://subroutine-cs.cc/",
  "description": description,
  "author": {
    "@type": "Person",
    "name": "Andrea Pallotta",
    "url": "https://andreapallotta.dev"
  },
  "publisher": {
    "@type": "Person",
    "name": "Andrea Pallotta"
  }
};
---

<!DOCTYPE html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="subroutine-cs, subroutine-cs.cc, subroutine cs, subroutine, computer science blog, algorithms visualizer, low level systems, C++ optimization, interactive CS" />
    <meta name="author" content="Andrea Pallotta" />
    <meta name="robots" content="index, follow" />
    <meta name="google-site-verification" content="sazdq0wR9lArF-dhJ3HU9AzwxT7qdY0YtMBKLlFpSrU" />

    <!-- SEO Canonical, Sitemap, & RSS Links -->
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="Subroutine CS RSS Feed" href="/rss.xml" />

    <!-- Open Graph / Facebook / LinkedIn Cards -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Subroutine CS - Interactive Computer Science & Systems Blog" />

    <!-- Twitter Cards -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/favicon.svg" />

    <!-- JSON-LD Structured Data Schema -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdSchema)} />

    <!-- Google Analytics (GA4) Global Site Tag -->
    {gaMeasurementId && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`}></script>
        <script is:inline define:vars={{ gaMeasurementId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', gaMeasurementId, {
            send_page_view: true
          });
        </script>
      </>
    )}

    <!-- KaTeX CSS for math typesetting -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css" />

    <!-- Mermaid JS library for inline diagram rendering -->
    <script is:inline src="https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.min.js"></script>
  </head>
  <body class="min-h-screen bg-slate-950 text-slate-100 font-sans antialiased selection:bg-cyan-500 selection:text-slate-950">
    {/* Left Vertical Sidebar Navigation */}
    <SidebarNavigation client:load articles={articles} currentSlug={currentSlug} />

    {/* Main Content Area */}
    <div class="md:pl-72 min-h-screen flex flex-col justify-between">
      <main class="flex-1 max-w-5xl w-full mx-auto px-4 md:px-8 py-6 md:py-10">
        <slot />
      </main>

      {/* Footer Component */}
      <Footer />
    </div>

    <!-- Client-Side Mermaid Diagram Inline Renderer -->
    <script is:inline>
      (function() {
        function renderMermaid() {
          if (typeof mermaid === 'undefined') return;

          mermaid.initialize({
            startOnLoad: false,
            theme: 'dark',
            themeVariables: {
              darkMode: true,
              background: '#090d16',
              primaryColor: '#1e293b',
              primaryTextColor: '#f8fafc',
              primaryBorderColor: '#38bdf8',
              lineColor: '#38bdf8',
              secondaryColor: '#0f172a',
              tertiaryColor: '#1e1b4b'
            }
          });

          var blocks = document.querySelectorAll('pre[data-language="mermaid"], pre.language-mermaid, pre code.language-mermaid');
          blocks.forEach(function(el, idx) {
            var preEl = el.tagName.toLowerCase() === 'pre' ? el : el.parentElement;
            var codeText = el.innerText || el.textContent || '';
            if (!codeText.trim()) return;

            var container = document.createElement('div');
            container.className = 'mermaid-diagram my-6 p-6 rounded-2xl bg-[#090d16] border border-slate-800 flex justify-center overflow-x-auto shadow-xl';

            mermaid.render('mermaid-id-' + idx + '-' + Date.now(), codeText.trim()).then(function(res) {
              container.innerHTML = res.svg;
              if (preEl && preEl.parentNode) {
                preEl.parentNode.replaceChild(container, preEl);
              }
            }).catch(function(err) {
              console.error('Mermaid parse error:', err);
            });
          });
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', renderMermaid);
        } else {
          renderMermaid();
        }
      })();
    </script>
  </body>
</html>
