---
import { Rss, Github, Globe, Code2 } from 'lucide-react';
---

<footer class="mt-20 border-t border-slate-800/80 bg-slate-950/90 py-10 px-4 md:px-8 text-xs text-slate-400 font-sans">
  <div class="max-w-5xl mx-auto flex flex-col md:flex-row items-center justify-between gap-6">
    
    {/* Left Column: Brand & Author */}
    <div class="space-y-2 text-center md:text-left">
      <div class="flex items-center justify-center md:justify-start gap-2 font-mono font-bold text-sm text-slate-200">
        <Code2 className="w-4 h-4 text-cyan-400" />
        <span>Subroutine CS</span>
      </div>
      <p class="text-slate-400 text-xs">
        An interactive educational blog covering algorithms, low-level systems, C++, and networking.
      </p>
      <p class="text-slate-500 text-[11px] font-mono">
        Created by <a href="https://andreapallotta.dev" target="_blank" rel="noopener noreferrer" class="text-cyan-400 hover:text-cyan-300 underline font-semibold transition-colors">Andrea Pallotta</a>
      </p>
    </div>

    {/* Right Column: Links & Feeds */}
    <div class="flex flex-wrap items-center justify-center gap-6 font-mono text-xs text-slate-400">
      <a
        href="/rss.xml"
        target="_blank"
        class="flex items-center gap-1.5 hover:text-cyan-400 transition-colors"
        title="RSS Feed"
      >
        <Rss className="w-3.5 h-3.5 text-amber-400" />
        <span>RSS Feed</span>
      </a>

      <a
        href="https://github.com/AndreaPallotta/subroutine"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-1.5 hover:text-cyan-400 transition-colors"
        title="GitHub Repository"
      >
        <Github className="w-3.5 h-3.5 text-slate-300" />
        <span>GitHub</span>
      </a>

      <a
        href="https://andreapallotta.dev"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-1.5 hover:text-cyan-400 transition-colors"
        title="Andrea Pallotta Portfolio"
      >
        <Globe className="w-3.5 h-3.5 text-indigo-400" />
        <span>andreapallotta.dev</span>
      </a>
    </div>
  </div>

  <div class="max-w-5xl mx-auto mt-8 pt-4 border-t border-slate-900 flex flex-wrap items-center justify-between gap-4 text-[11px] font-mono text-slate-600">
    <span>© 2026 Subroutine CS (subroutine-cs.cc). All rights reserved.</span>
    <span>Built with Astro, React, & Tailwind CSS.</span>
  </div>
</footer>
